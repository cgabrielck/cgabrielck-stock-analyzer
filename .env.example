# =============================================================================
# ALPHA//DESK secrets — copy to `.env` at the repo root (or VPS
# /opt/stock-analyzer/.env). Never commit real keys. chmod 600 recommended.
# What to buy and when: docs/PROCUREMENT_GUIDE.md
# =============================================================================

# --- Phase 1 (required for Shadow / Paper) -----------------------------------
# Alpaca brokerage. Keep APCA_PAPER=true during validation.
# Open a free Paper account: https://alpaca.markets/
APCA_API_KEY_ID=replace-with-your-alpaca-key-id
APCA_API_SECRET_KEY=replace-with-your-alpaca-secret
APCA_PAPER=true
# Allow strategy cycles outside US RTH (local gate only; broker may still restrict fills).
IGNORE_MARKET_HOURS=false
# Worker OHLCV: empty/0/all = full universe each cycle. Batch + pause avoid Yahoo bans.
# WORKER_UNIVERSE_CAP=all
# WORKER_FETCH_BATCH=8
# WORKER_FETCH_PAUSE_SEC=0.4

# Auto Scan while FastAPI desk is running (US Mon–Fri session slots + LLM top-15).
# SCAN_AUTO=1
# SCAN_INTERVAL_MIN=120
# SCAN_USE_LLM=true
# SCAN_OUTSIDE_HOURS=false
# SCAN_STALE_AFTER_HOURS=72

# Telegram ops alerts (fills, kill switch, daily P&L). Free via @BotFather.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_CHAT_ID=replace-with-your-chat-id
ALERT_OWNER_USER_ID=replace-with-your-stock-analyzer-user-uuid

# Optional LLM enrichment for research UI (does NOT bypass risk gates).
LLM_API_KEY=replace-with-your-panda-api-key
LLM_BASE_URL=https://api520.pro/v1
LLM_MODEL=熊猫-特供-按量-满血逆-claude-sonnet-4.6
LLM_REASONING_MODEL=熊猫-按量-满血非量化-deepseek-v4-pro
# LLM_MACRO_MODEL=熊猫-按量-gpt-5.6-terra
# LLM_COMPLEX_MATH_MODEL=熊猫-按量-gpt-5.6-luna
LLM_TIMEOUT_SECONDS=60

# Durable order ledger on the VPS worker (SQLite is enough for Phase 1–2).
# ORDER_STORE_BACKEND=sqlite
# ORDER_STORE_PATH=backend/data/orders.sqlite3

# --- Phase 2 (buy before serious multi-month seal; delayed stocks OK) --------
# Polygon / Massive equity daily bars. Prefer non-Advanced first for day-bar bots.
# See docs/PROCUREMENT_GUIDE.md and docs/PAID_DATA_PIT_PLAN.md
POLYGON_API_KEY=replace-with-your-polygon-or-massive-key
# POLYGON_BASE_URL=https://api.polygon.io

# Optional fundamentals / adjusted daily fallback.
ALPHA_VANTAGE_API_KEY=replace-with-your-key

# --- Phase 3+ only (after PAPER_VALIDATION_RUNBOOK sign-off) -----------------
# Do NOT set APCA_PAPER=false until Stage 3 checklist is signed.
# Optional realtime stock SIP: Alpaca paid data OR Polygon Stocks Advanced
# (pick one — do not pay twice). Optional options: MarketData / Polygon Options.
# DATABASE_URL=postgresql://user:pass@localhost:5432/alphadesk

# --- Research extras (optional anytime) --------------------------------------
TRADIER_API_TOKEN=replace-with-your-production-token
TRADIER_BASE_URL=https://api.tradier.com/v1

# Optional Supabase account storage. Keep the service-role key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Optional external price-alert worker interval (seconds).
ALERT_INTERVAL_SECONDS=60
